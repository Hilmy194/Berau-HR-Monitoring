DATABASE_URL="postgresql://postgres.project-ref:your-password@your-pooler-host:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres"
SESSION_POOL_URL="postgresql://postgres.project-ref:your-password@your-session-pooler-host:5432/postgres"
DATABASE_POOL_SIZE="10"
DATABASE_SSL_MODE="require"
APP_ENV="development"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Server-side only. Never prefix these keys with NEXT_PUBLIC_.
AI_FEATURE_ENABLED="true"
AI_PROVIDER="openai"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.6-flash"
GOOGLE_AI_MODEL="gemini-3.6-flash"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5-mini"
OPENAI_TALENT_MODEL="gpt-5-mini"
AI_MAX_CANDIDATES="5"
AI_MAX_INPUT_SIZE="24000"
AI_REQUEST_TIMEOUT="120000"
AI_MAX_OUTPUT_TOKENS="4000"
OPENAI_REASONING_EFFORT="minimal"
