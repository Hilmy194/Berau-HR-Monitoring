# Neon PostgreSQL
# Use the pooled Neon URL for Vercel/runtime.
# Do not include `channel_binding=require`.
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@YOUR_PROJECT-pooler.YOUR_REGION.aws.neon.tech/neondb?sslmode=require"

# Use the direct Neon URL for Prisma migrations and seed scripts.
# Do not include `channel_binding=require`.
DIRECT_URL="postgresql://neondb_owner:YOUR_PASSWORD@YOUR_PROJECT.YOUR_REGION.aws.neon.tech/neondb?sslmode=require"

# App
APP_ENV="production"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_URL="https://your-project-name.vercel.app"

# Initial Super Admin HR (required password in production bootstrap).
# SUPER_ADMIN_NAME="Super Admin HR"
# SUPER_ADMIN_EMAIL="admin@hrdigital.com"
# SUPER_ADMIN_PASSWORD="replace-with-a-strong-password"

# Server-side only. Never prefix these keys with NEXT_PUBLIC_.
AI_FEATURE_ENABLED="true"
AI_PROVIDER="openai"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.6-terra"
OPENAI_TALENT_MODEL="gpt-5.6-terra"
AI_MAX_CANDIDATES="5"
AI_MAX_INPUT_SIZE="24000"
AI_REQUEST_TIMEOUT="120000"
AI_MAX_OUTPUT_TOKENS="4000"
OPENAI_REASONING_EFFORT="minimal"

# HR source integrations. Keep credentials in the scheduler/secret manager,
# never in a Postman collection or a NEXT_PUBLIC_ variable.
# BQ_HR_EXPORT_FILE="C:/secure-exports/bq-hr.json"
# BigQuery scheduler configuration belongs in a separate secret-safe file,
# for example C:/secure/bq-hr-sync.env (do not commit it):
# BQ_SERVICE_ACCOUNT_FILE="C:/secure/harmoni-bq-service-account.json"
# BQ_PROJECT_ID="your-gcp-project-id"
# BQ_DATASET="hr_analytics"
# BQ_TABLE_P_EMPS="p_emps"
# BQ_TABLE_P_TALENT_PROFILE="p_talent_profile"
# BQ_TABLE_P_CAREER_HISTORY="p_career_history"
# BQ_EXPORT_FILE="C:/secure-exports/bq-hr.json"
# HSECT_EXPORT_FILE="C:/secure-exports/hsect.json"
# HSECT_API_BASE_URL="https://hseautomation.beraucoal.co.id/sid2"
# HSECT_API_KEY=""

# HR Core PostgreSQL (server-side, read-only). Use hrcore-postgres:5432 when
# the app joins Docker network `shared-network`; use 10.12.19.2:5435 in VPC.
# Never prefix these variables with NEXT_PUBLIC_. SSL mode `prefer` and
# default_transaction_read_only are enforced by the application pool.
HR_CORE_HOST="hrcore-postgres"
HR_CORE_PORT="5432"
HR_CORE_DATABASE="hrcore"
HR_CORE_USER="replace-with-read-only-role"
HR_CORE_PASSWORD=""
HR_CORE_POOL_MAX="5"
# Alternative single secret; when set it takes precedence over fields above:
# HR_CORE_DATABASE_URL="postgresql://READ_ONLY_ROLE:PASSWORD@hrcore-postgres:5432/hrcore?sslmode=prefer"
