# Copy to /etc/hr-monitoring/app.env; readable only by the app/job account.
# Percent-encode reserved characters in the PostgreSQL password.
# Both URLs point to the same PostgreSQL database on this VM.
DATABASE_URL='postgresql://hr_app:REPLACE_PASSWORD@127.0.0.1:5432/hr_monitoring?schema=public'
DIRECT_URL='postgresql://hr_app:REPLACE_PASSWORD@127.0.0.1:5432/hr_monitoring?schema=public'
APP_ENV='production'
NEXTAUTH_URL='https://hr.example.com'
NEXTAUTH_SECRET='REPLACE_WITH_LONG_RANDOM_SECRET'

# Configure optional server-side services separately when used.
# HR_CORE_HOST='...'
# HR_CORE_PORT='5432'
# HR_CORE_DATABASE='hrcore'
# HR_CORE_USER='...'
# HR_CORE_PASSWORD='...'
