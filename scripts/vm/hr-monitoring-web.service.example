[Unit]
Description=HR Monitoring Next.js web application
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=hrmonitoring
Group=hrmonitoring
WorkingDirectory=/opt/hr-monitoring
EnvironmentFile=/etc/hr-monitoring/app.env
ExecStart=/usr/bin/npm run start -- --hostname 127.0.0.1 --port 3000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
