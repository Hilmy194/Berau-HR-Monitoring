# Copy to /etc/hr-monitoring/integrations.env; readable only by the job account.
# These paths refer to files on the Linux VM, not to C: paths on the laptop.
BQ_SERVICE_ACCOUNT_FILE='/etc/hr-monitoring/bq-service-account.json'
BQ_PROJECT_ID='REPLACE_GCP_PROJECT_ID'
BQ_DATASET='REPLACE_BQ_DATASET'
BQ_TABLE_P_EMPS='p_emps'
BQ_TABLE_P_TALENT_PROFILE='p_talent_profile'
BQ_TABLE_P_CAREER_HISTORY='p_career_history'
BQ_EXPORT_FILE='/var/lib/hr-monitoring/bq-hr.json'

# Leave BQ_RAW_DATABASE_URL unset so raw BQ and HSE matching use DATABASE_URL
# from app.env, which is the same database read by the web application.
HSECT_POSTMAN_COLLECTION_FILE='/etc/hr-monitoring/hsect-collection.json'
HSECT_RAW_EXPORT_FILE='/var/lib/hr-monitoring/hsect-raw.json'
HSECT_EXPORT_FILE='/var/lib/hr-monitoring/hsect-normalized.json'
# HSECT_COMPANY_IDS='5194'
# HSECT_API_KEY='REPLACE_ONLY_IF_NOT_IN_COLLECTION'
# HSECT_TOKEN='REPLACE_ONLY_IF_REQUIRED'
